{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looprig.dev/schemas/windows-runtime-trace-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collector", "raw_trace_sha256", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "command"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1}
      }
    },
    "raw_trace_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runtime", "complete", "denials"],
        "properties": {
          "runtime": {"type": "string", "minLength": 1},
          "complete": {"const": true},
          "denials": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "requested_access", "object_path", "object_identity", "owner", "dacl"],
              "properties": {
                "operation": {"type": "string", "minLength": 1},
                "requested_access": {"type": "string", "minLength": 1},
                "object_path": {"type": "string", "minLength": 1},
                "object_identity": {"type": "string", "minLength": 1},
                "owner": {"type": "string", "minLength": 1},
                "dacl": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
