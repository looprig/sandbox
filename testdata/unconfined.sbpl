(version 1)
(deny default)
(allow process-fork)
(allow process-exec*)
(allow file-read*)
(allow sysctl-read)
(allow mach-lookup)
; --- filesystem ---
(allow file-read* (subpath "/"))
(allow process-exec* (subpath "/"))
(allow file-write* (subpath "/"))
(allow file-read* (subpath "/dev/null"))
(allow file-write* (subpath "/dev/null"))
; --- network ---
(allow network*)
