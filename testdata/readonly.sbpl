(version 1)
(deny default)
(allow process-fork)
(allow process-exec*)
(allow file-read*)
(allow sysctl-read)
(allow mach-lookup)
; --- filesystem ---
(allow file-read* (subpath "/"))
(allow process-exec* (subpath "/"))
(allow file-read* (subpath "/dev/null"))
(allow file-write* (subpath "/dev/null"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/.ssh"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/.aws"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/.gnupg"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/.kube"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/.config/gh"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/.netrc"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/.docker/config.json"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/Library/Keychains"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/.local/share/keyrings"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/Library/Application Support/Google/Chrome"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/Library/Application Support/Chromium"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/Library/Application Support/BraveSoftware"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/Library/Application Support/Microsoft Edge"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/Library/Application Support/Firefox"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/Library/Safari"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/.config/google-chrome"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/.config/chromium"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/.config/BraveSoftware"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/.config/microsoft-edge"))
(deny file-read* file-write* (subpath "/lrsbx-home/tester/.mozilla"))
(deny file-read* file-write* (subpath "/Library/Keychains"))
(deny file-read* file-write* (regex #"^.*/\.env[^/]*$"))
; --- network ---
